# ============================================================
# Real-Time Chat API — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to source control.
# ============================================================

# --- App ---
APP_NAME="Real-Time Chat API"
APP_VERSION="1.0.0"
DEBUG=false
ENVIRONMENT=development

# --- Auth ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=your-super-secret-key-minimum-32-chars-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql+asyncpg://chat:chatpassword@postgres:5432/chatdb

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- CORS ---
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:8080"]

# --- Rate Limiting ---
RATE_LIMIT_PER_MINUTE=60

# --- File Upload ---
MAX_FILE_SIZE_MB=10
UPLOAD_DIR=uploads/images

# --- Presence ---
PRESENCE_TTL_SECONDS=300
TYPING_TTL_SECONDS=5
