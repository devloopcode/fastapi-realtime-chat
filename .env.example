# ============================================================
# Real-Time Chat API — Environment Variables
# Copy this file to .env and fill in your values.
# ============================================================

# --- App ---
APP_NAME=
APP_VERSION="1.0.0"
DEBUG=
ENVIRONMENT=

# --- Auth ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=
ALGORITHM=
ACCESS_TOKEN_EXPIRE_MINUTES=
REFRESH_TOKEN_EXPIRE_DAYS=

# --- Database (PostgreSQL) ---
DATABASE_URL=

# --- Redis ---
REDIS_URL=

# --- CORS ---
ALLOWED_ORIGINS=[]

# --- Rate Limiting ---
RATE_LIMIT_PER_MINUTE=

# --- File Upload ---
MAX_FILE_SIZE_MB=
UPLOAD_DIR=

# --- Presence ---
PRESENCE_TTL_SECONDS=
TYPING_TTL_SECONDS=
